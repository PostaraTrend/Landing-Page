<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  /* ============================================================
     ROLE SCOUT, PUBLIC JOBS PAGE
     Design tokens
     ============================================================ */
  :root{
    --paper:#F5F4EF;         /* warm cool paper, the page ground */
    --card:#FFFFFF;
    --ink:#17231E;           /* deep evergreen ink for text */
    --ink-soft:#4A574F;      /* secondary text */
    --ink-faint:#7C877F;     /* captions, meta */
    --forest:#1F5C46;        /* primary brand green */
    --forest-deep:#0E3A2A;
    --amber:#B87118;         /* wayfinding accent, actions and highlights */
    --amber-soft:#F3E6D2;
    --line:#E4E2D9;          /* hairline borders */
    --line-strong:#D5D3C7;
    --jobbank:#0B4B8F;       /* Government of Canada blue, used only on the Job Bank badge */
    --jobbank-soft:#E4EDF7;
    --focus:#B87118;
    --radius:14px;
    --radius-sm:9px;
    --shadow:0 1px 2px rgba(23,35,30,.04), 0 8px 24px rgba(23,35,30,.05);
    --maxw:1080px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:"Inter",system-ui,sans-serif;
    font-size:16px;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit;}
  h1,h2,h3{font-family:"Bricolage Grotesque","Inter",sans-serif;font-weight:700;letter-spacing:-.01em;margin:0;}
  button{font-family:inherit;cursor:pointer;}

  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 22px;}

  /* ---------- Header ---------- */
  header.site{
    position:sticky;top:0;z-index:20;
    background:rgba(245,244,239,.86);
    backdrop-filter:saturate(1.2) blur(8px);
    border-bottom:1px solid var(--line);
  }
  .bar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 0;}
  .brand{display:flex;align-items:center;gap:11px;text-decoration:none;}
  .mark{width:34px;height:34px;flex:0 0 auto;}
  .brand-name{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:20px;letter-spacing:-.02em;color:var(--ink);}
  .brand-tag{font-size:12.5px;color:var(--ink-faint);margin-top:1px;letter-spacing:.01em;}
  .signin{
    font-size:14px;font-weight:500;color:var(--forest-deep);
    text-decoration:none;padding:9px 15px;border:1px solid var(--line-strong);
    border-radius:999px;white-space:nowrap;transition:border-color .15s,background .15s;
  }
  .signin:hover{border-color:var(--forest);background:#fff;}

  /* ---------- Hero ---------- */
  .hero{padding:52px 0 30px;}
  .eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-size:12.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
    color:var(--forest);margin-bottom:18px;
  }
  .eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--amber);}
  .hero h1{font-size:clamp(30px,5vw,50px);line-height:1.03;max-width:15ch;}
  .hero h1 .u{
    background:linear-gradient(transparent 62%,var(--amber-soft) 62%);
    padding:0 .05em;
  }
  .hero p.lede{
    margin:20px 0 0;max-width:56ch;font-size:clamp(16px,2vw,18px);color:var(--ink-soft);
  }

  /* route motif under hero */
  .route{margin:26px 0 4px;height:14px;width:100%;max-width:520px;opacity:.7;}

  /* ---------- Search panel ---------- */
  .panel{
    margin-top:22px;background:var(--card);border:1px solid var(--line);
    border-radius:var(--radius);box-shadow:var(--shadow);padding:16px;
    display:grid;grid-template-columns:1fr 190px 190px;gap:12px;
  }
  .field{display:flex;flex-direction:column;gap:6px;}
  .field label{
    font-size:11.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-faint);
    padding-left:2px;
  }
  .control{
    appearance:none;width:100%;background:#fff;border:1px solid var(--line-strong);
    border-radius:var(--radius-sm);padding:12px 13px;font-size:15px;color:var(--ink);
    transition:border-color .15s, box-shadow .15s;
  }
  .search-wrap{position:relative;}
  .search-wrap .control{padding-left:40px;}
  .search-wrap svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--ink-faint);}
  select.control{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%237C877F' stroke-width='2'><path d='M6 9l6 6 6-6'/></svg>");background-repeat:no-repeat;background-position:right 12px center;padding-right:36px;}
  .control:focus{outline:none;border-color:var(--forest);box-shadow:0 0 0 3px rgba(31,92,70,.14);}

  /* ---------- Results meta ---------- */
  .meta-row{
    display:flex;align-items:baseline;justify-content:space-between;gap:12px;
    margin:34px 0 16px;flex-wrap:wrap;
  }
  .count{font-family:"Bricolage Grotesque",sans-serif;font-weight:700;font-size:22px;}
  .count span{color:var(--forest);}
  .freshness{font-size:13px;color:var(--ink-faint);display:inline-flex;align-items:center;gap:7px;}
  .freshness .live{width:8px;height:8px;border-radius:50%;background:var(--forest);box-shadow:0 0 0 0 rgba(31,92,70,.5);animation:pulse 2.4s infinite;}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(31,92,70,.45);}70%{box-shadow:0 0 0 7px rgba(31,92,70,0);}100%{box-shadow:0 0 0 0 rgba(31,92,70,0);}}

  /* ---------- Job grid ---------- */
  .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;}
  .job{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:20px 20px 18px;display:flex;flex-direction:column;gap:12px;
    transition:border-color .15s, transform .15s, box-shadow .15s;
  }
  .job:hover{border-color:var(--line-strong);transform:translateY(-2px);box-shadow:var(--shadow);}
  .job-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;}
  .job h3{font-size:18px;line-height:1.22;}
  .job h3 a{text-decoration:none;}
  .job h3 a:hover{color:var(--forest);}
  .job .employer{font-size:14.5px;color:var(--ink-soft);font-weight:500;margin-top:3px;}
  .job .where{font-size:13.5px;color:var(--ink-faint);margin-top:2px;}

  /* source badge */
  .badge{
    flex:0 0 auto;display:inline-flex;align-items:center;gap:6px;
    font-size:11.5px;font-weight:600;letter-spacing:.02em;
    padding:5px 10px;border-radius:999px;white-space:nowrap;
    background:#F1F0EA;color:var(--ink-soft);border:1px solid var(--line);
  }
  .badge.jobbank{background:var(--jobbank-soft);color:var(--jobbank);border-color:#CBDCEF;}
  .badge .compass{width:12px;height:12px;}

  .job-foot{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:4px;}
  .posted{font-size:12.5px;color:var(--ink-faint);}
  .origin-note{font-size:12px;color:var(--jobbank);margin-top:-4px;}
  .view{
    display:inline-flex;align-items:center;gap:7px;
    font-size:13.5px;font-weight:600;color:#fff;background:var(--forest);
    padding:9px 14px;border-radius:999px;text-decoration:none;border:1px solid var(--forest);
    transition:background .15s,border-color .15s;
  }
  .view:hover{background:var(--forest-deep);border-color:var(--forest-deep);}
  .view svg{transition:transform .15s;}
  .view:hover svg{transform:translate(2px,-2px);}

  /* sample fallback banner */
  .sample-banner{
    margin:22px 0 -6px;padding:12px 15px;border-radius:var(--radius-sm);
    background:var(--amber-soft);border:1px solid #E7D4B4;color:#7A4E12;
    font-size:13.5px;
  }
  .sample-banner[hidden]{display:none;}

  /* empty + load more */
  .empty{
    grid-column:1/-1;text-align:center;padding:56px 20px;color:var(--ink-soft);
    border:1px dashed var(--line-strong);border-radius:var(--radius);background:rgba(255,255,255,.5);
  }
  .empty strong{display:block;font-family:"Bricolage Grotesque",sans-serif;font-size:19px;color:var(--ink);margin-bottom:6px;}
  .more-row{display:flex;justify-content:center;margin:26px 0 8px;}
  .more{
    font-size:14.5px;font-weight:600;color:var(--forest-deep);background:#fff;
    border:1px solid var(--line-strong);border-radius:999px;padding:12px 22px;transition:border-color .15s,background .15s;
  }
  .more:hover{border-color:var(--forest);}
  .more[hidden]{display:none;}

  /* skeleton */
  .skeleton{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;height:168px;overflow:hidden;position:relative;}
  .skeleton::after{content:"";position:absolute;inset:0;transform:translateX(-100%);background:linear-gradient(90deg,transparent,rgba(0,0,0,.035),transparent);animation:sweep 1.3s infinite;}
  @keyframes sweep{100%{transform:translateX(100%);}}

  /* ---------- Footer ---------- */
  footer.site{margin-top:60px;border-top:1px solid var(--line);background:#fff;}
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:30px;padding:40px 0 30px;}
  footer h4{font-family:"Bricolage Grotesque",sans-serif;font-size:15px;margin:0 0 10px;}
  footer p{font-size:14px;color:var(--ink-soft);margin:0 0 12px;max-width:60ch;}
  .attrib{font-size:13px;color:var(--ink-faint);}
  .foot-mark{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
  .foot-mark span{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:17px;}
  .legal{border-top:1px solid var(--line);padding:16px 0;font-size:12.5px;color:var(--ink-faint);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;}
  .legal a{color:var(--forest-deep);}

  /* ---------- Responsive ---------- */
  @media (max-width:820px){
    .panel{grid-template-columns:1fr;}
    .grid{grid-template-columns:1fr;}
    .foot-grid{grid-template-columns:1fr;gap:22px;}
    .hero{padding:38px 0 22px;}
  }
  @media (prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important;scroll-behavior:auto!important;}
  }
  :focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-radius:4px;}
</style>
</head>
