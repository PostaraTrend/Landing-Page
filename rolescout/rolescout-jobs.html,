<script>
/* ============================================================
   DATA LAYER
   Live mode reads from Supabase REST when config is present.
   Otherwise the page renders on the SAMPLE set below so it can
   be previewed and reviewed with no backend.
   ============================================================ */

const SAMPLE = [
  {title:"Settlement Support Worker", employer:"Calgary Newcomer Centre", location:"Calgary, AB", posted_date:daysAgo(1), source:"jobbank", country:"Canada", url:"https://www.jobbank.gc.ca/jobsearch/jobposting/00000001"},
  {title:"Registered Nurse, Acute Care", employer:"Alberta Health Services", location:"Edmonton, AB", posted_date:daysAgo(2), source:"jobbank", country:"Canada", url:"https://www.jobbank.gc.ca/jobsearch/jobposting/00000002"},
  {title:"Junior Software Developer", employer:"Neo Financial", location:"Calgary, AB", posted_date:daysAgo(1), source:"greenhouse", country:"Canada", url:"https://boards.greenhouse.io/example/jobs/1"},
  {title:"Warehouse Associate", employer:"Sysco Canada", location:"Winnipeg, MB", posted_date:daysAgo(3), source:"jobbank", country:"Canada", url:"https://www.jobbank.gc.ca/jobsearch/jobposting/00000003"},
  {title:"Customer Success Manager", employer:"Jobber", location:"Remote, Canada", posted_date:daysAgo(2), source:"lever", country:"Canada", url:"https://jobs.lever.co/example/1"},
  {title:"IT Service Desk Analyst", employer:"City of Calgary", location:"Calgary, AB", posted_date:daysAgo(4), source:"jobbank", country:"Canada", url:"https://www.jobbank.gc.ca/jobsearch/jobposting/00000004"},
  {title:"Data Analyst", employer:"Reed Talent Solutions", location:"London, UK", posted_date:daysAgo(2), source:"reed", country:"UK", url:"https://www.reed.co.uk/jobs/example/1"},
  {title:"Product Designer", employer:"Remotive Partner", location:"Remote, Worldwide", posted_date:daysAgo(3), source:"remotive", country:"Global", url:"https://remotive.com/remote-jobs/example/1"},
  {title:"Accounting Clerk", employer:"MNP LLP", location:"Red Deer, AB", posted_date:daysAgo(5), source:"jobbank", country:"Canada", url:"https://www.jobbank.gc.ca/jobsearch/jobposting/00000005"},
  {title:"Federal Program Analyst", employer:"U.S. Department of Commerce", location:"Washington, DC", posted_date:daysAgo(2), source:"usajobs", country:"USA", url:"https://www.usajobs.gov/job/000000001"},
  {title:"Early Childhood Educator", employer:"YMCA Calgary", location:"Calgary, AB", posted_date:daysAgo(6), source:"jobbank", country:"Canada", url:"https://www.jobbank.gc.ca/jobsearch/jobposting/00000006"},
  {title:"DevOps Engineer", employer:"Ashby Example Co", location:"Remote, Canada", posted_date:daysAgo(3), source:"ashby", country:"Canada", url:"https://jobs.ashbyhq.com/example/1"}
];

/* label + linkback wording per source */
function sourceMeta(src){
  const s = (src||"").toLowerCase();
  if(s === "jobbank") return {label:"Job Bank", jobbank:true};
  const named = {
    usajobs:"USAJOBS", reed:"Reed", remotive:"Remotive", jobicy:"Jobicy",
    himalayas:"Himalayas", themuse:"The Muse", muse:"The Muse",
    remotejobs:"RemoteJobs.org", fantastic:"Fantastic.jobs"
  };
  if(named[s]) return {label:named[s], jobbank:false};
  if(["greenhouse","lever","ashby","smartrecruiters","workable","recruitee","personio"].includes(s)) return {label:"Employer site", jobbank:false};
  return {label:"Job listing", jobbank:false};
}

const MARKET_ORDER = ["Canada","USA","UK","Ireland","UAE","Nigeria","Saudi Arabia","Qatar","Kuwait","Oman","Bahrain","Angola","Global"];

/* ---------- state ---------- */
const state = { all:[], filtered:[], shown:0, live:false };
const els = {
  grid: document.getElementById("grid"),
  count: document.getElementById("count"),
  q: document.getElementById("q"),
  market: document.getElementById("market"),
  source: document.getElementById("source"),
  more: document.getElementById("moreBtn")
};

init();

async function init(){
  showSkeletons();
  const cfg = ROLE_SCOUT_CONFIG;
  if(cfg.SUPABASE_URL && cfg.SUPABASE_ANON_KEY){
    try{
      state.all = await fetchLive(cfg);
      state.live = true;
    }catch(err){
      console.warn("Live fetch failed, showing sample set.", err);
      state.all = SAMPLE.slice();
      state.liveFailed = true;
    }
  }else{
    state.all = SAMPLE.slice();
  }
  buildFilters();
  bindEvents();
  applyFilters();
  if(state.liveFailed){ const b=document.getElementById("sampleBanner"); if(b) b.hidden=false; }
}

async function fetchLive(cfg){
  const base = cfg.SUPABASE_URL.replace(/\/+$/,"");
  const cols = "title,employer,location,posted_date,source,url,country";
  const endpoint = base + "/rest/v1/postings?select=" + cols +
              "&active=eq.true&order=posted_date.desc.nullslast&limit=1000";
  const res = await fetch(endpoint, {
    headers:{ apikey: cfg.SUPABASE_ANON_KEY, Authorization: "Bearer " + cfg.SUPABASE_ANON_KEY }
  });
  if(!res.ok) throw new Error("HTTP " + res.status);
  const rows = await res.json();
  return rows.filter(r => r && r.title && r.url);
}

/* ---------- filters ---------- */
function buildFilters(){
  const markets = new Set(state.all.map(j => j.country).filter(Boolean));
  MARKET_ORDER.forEach(m => { if(markets.has(m)) addOption(els.market, m, m); });
  [...markets].filter(m => !MARKET_ORDER.includes(m)).sort().forEach(m => addOption(els.market, m, m));

  const seen = new Map();
  state.all.forEach(j => { const m = sourceMeta(j.source); if(!seen.has(m.label)) seen.set(m.label, j.source); });
  [...seen.keys()].sort().forEach(label => addOption(els.source, label, label));
}
function addOption(sel, value, text){ const o=document.createElement("option"); o.value=value; o.textContent=text; sel.appendChild(o); }

function bindEvents(){
  let t;
  els.q.addEventListener("input", ()=>{ clearTimeout(t); t=setTimeout(applyFilters,140); });
  els.market.addEventListener("change", applyFilters);
  els.source.addEventListener("change", applyFilters);
  els.more.addEventListener("click", ()=>{ state.shown += ROLE_SCOUT_CONFIG.PAGE_SIZE; renderPage(); });
}

function applyFilters(){
  const q = els.q.value.trim().toLowerCase();
  const market = els.market.value;
  const source = els.source.value;
  state.filtered = state.all.filter(j=>{
    if(market && j.country !== market) return false;
    if(source && sourceMeta(j.source).label !== source) return false;
    if(q){
      const hay = (j.title+" "+(j.employer||"")+" "+(j.location||"")).toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });
  state.shown = ROLE_SCOUT_CONFIG.PAGE_SIZE;
  renderPage();
}

/* ---------- render ---------- */
function renderPage(){
  const total = state.filtered.length;
  els.count.innerHTML = total
    ? "<span>"+total+"</span> open "+(total===1?"position":"positions")
    : "No postings match your search";
  els.grid.innerHTML = "";

  if(total === 0){
    const e=document.createElement("div"); e.className="empty";
    e.innerHTML="<strong>Nothing here yet</strong>Try a broader keyword, or choose a different market or source.";
    els.grid.appendChild(e);
    els.more.hidden = true;
    return;
  }
  const slice = state.filtered.slice(0, state.shown);
  slice.forEach(j => els.grid.appendChild(card(j)));
  els.more.hidden = state.shown >= total;
}

function card(j){
  const meta = sourceMeta(j.source);
  const el = document.createElement("article"); el.className="job";

  const top = document.createElement("div"); top.className="job-top";
  const head = document.createElement("div");
  const h = document.createElement("h3");
  const a = document.createElement("a");
  a.href = j.url; a.target="_blank"; a.rel="noopener noreferrer";
  a.textContent = j.title;
  h.appendChild(a); head.appendChild(h);
  if(j.employer){ const emp=document.createElement("div"); emp.className="employer"; emp.textContent=j.employer; head.appendChild(emp); }
  if(j.location){ const w=document.createElement("div"); w.className="where"; w.textContent=j.location; head.appendChild(w); }
  top.appendChild(head);

  const badge = document.createElement("span");
  badge.className = "badge" + (meta.jobbank ? " jobbank" : "");
  badge.innerHTML = '<svg class="compass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5 5-2z" fill="currentColor" stroke="none"/></svg>' + escapeHtml(meta.label);
  badge.setAttribute("title","Source: "+meta.label);
  top.appendChild(badge);
  el.appendChild(top);

  if(meta.jobbank){
    const note=document.createElement("div"); note.className="origin-note";
    note.textContent="Original posting on Job Bank, the Government of Canada job board.";
    el.appendChild(note);
  }

  const foot=document.createElement("div"); foot.className="job-foot";
  const posted=document.createElement("span"); posted.className="posted"; posted.textContent = postedLabel(j.posted_date);
  foot.appendChild(posted);

  const view=document.createElement("a");
  view.className="view"; view.href=j.url; view.target="_blank"; view.rel="noopener noreferrer";
  view.innerHTML = 'View original posting <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>';
  view.setAttribute("aria-label","View original posting for "+j.title+" on "+meta.label);
  foot.appendChild(view);

  el.appendChild(foot);
  return el;
}

/* ---------- helpers ---------- */
function showSkeletons(){
  els.grid.innerHTML="";
  for(let i=0;i<6;i++){ const s=document.createElement("div"); s.className="skeleton"; els.grid.appendChild(s); }
}
function daysAgo(n){ const d=new Date(); d.setDate(d.getDate()-n); return d.toISOString().slice(0,10); }
function postedLabel(dateStr){
  if(!dateStr) return "Recently posted";
  const d=new Date(dateStr); if(isNaN(d)) return "Recently posted";
  const days=Math.floor((Date.now()-d.getTime())/86400000);
  if(days<=0) return "Posted today";
  if(days===1) return "Posted yesterday";
  if(days<7) return "Posted "+days+" days ago";
  if(days<14) return "Posted last week";
  if(days<31) return "Posted "+Math.floor(days/7)+" weeks ago";
  return "Posted on "+d.toLocaleDateString("en-CA",{month:"short",day:"numeric"});
}
function escapeHtml(str){ const d=document.createElement("div"); d.textContent=str==null?"":String(str); return d.innerHTML; }
</script>
